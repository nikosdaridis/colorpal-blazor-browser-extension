{
  "scripts": {
    "dev-watch": "concurrently \"npm run typescript-watch\" \"npm run tailwind-watch\"",
    "typescript-build": "npx tsc",
    "typescript-watch": "npx tsc --watch",
    "typescript-release": "npx tsc && node ./wwwroot/JavaScript/uglify.js",
    "tailwind-build": "npx @tailwindcss/cli -i ./wwwroot/CSS/app.css -o ./wwwroot/CSS/appTailwind.css",
    "tailwind-watch": "npx @tailwindcss/cli -i ./wwwroot/CSS/app.css -o ./wwwroot/CSS/appTailwind.css --watch",
    "tailwind-release": "npx @tailwindcss/cli -i ./wwwroot/CSS/app.css -o ./wwwroot/CSS/appTailwind.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "uglify-js": "^3.19.3"
  },
  "include": [
    "./wwwroot/TypeScript/**/*.ts"
  ]
}
