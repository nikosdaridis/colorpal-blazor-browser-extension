@inherits PageBase

@page "/settings"

<div class="space-y-4 p-4 text-[var(--theme-invert-color)]">
    <div class="flex items-center justify-between">
        <h2 class="text-xl font-bold">@LocalizationService.GetMessage(MessageKey.Settings)</h2>
        <TransparentRoundButton IconPath="Icons\arrow.svg"
                                AriaLabel=@LocalizationService.GetMessage(MessageKey.Back)
                                HandleClick=NavigateBackToHome />
    </div>

    <div class="space-y-4">
        <ThemeSettingsOption LocalStorageService=LocalStorageService
                             LocalizationService=LocalizationService
                             Label=@LocalizationService.GetMessage(MessageKey.Theme) />

        <ToggleSettingsOption LocalStorageService=LocalStorageService
                              StateService=StateService
                              Label=@LocalizationService.GetMessage(MessageKey.AutoSaveEyedropper)
                              StorageKey=StorageKey.AutoSaveEyedropper />

        <ToggleSettingsOption LocalStorageService=LocalStorageService
                              StateService=StateService
                              Label=@LocalizationService.GetMessage(MessageKey.AutoCopyCode)
                              StorageKey=StorageKey.AutoCopyCode />

        <ToggleSettingsOption LocalStorageService=LocalStorageService
                              StateService=StateService
                              Label=@LocalizationService.GetMessage(MessageKey.AddHashToHex)
                              StorageKey=StorageKey.AddHexCharacter />

        <ToggleSettingsOption LocalStorageService=LocalStorageService
                              StateService=StateService
                              Label=@LocalizationService.GetMessage(MessageKey.ShowColorName)
                              StorageKey=StorageKey.ShowColorNames />

        <ToggleSettingsOption LocalStorageService=LocalStorageService
                              StateService=StateService
                              Label=@LocalizationService.GetMessage(MessageKey.PrependBlackToFilter)
                              StorageKey=StorageKey.PrependBlackFilter />
    </div>

    <div class="flex items-center justify-between gap-4 pt-4">
        <RectangularLabelButton Label=@LocalizationService.GetMessage(MessageKey.Website)
                                IconPath="Icons\website.svg"
                                IconSize=Size.Small
                                HandleClick=@(async () => await JsInterop.InvokeVoidAsync(JsFunctions.OpenExternalUrl, WEBSITE_URL)) />
        <RectangularLabelButton Label="GitHub"
                                IconPath="Icons\github.svg"
                                IconSize=Size.Small
                                HandleClick=@(async () => await JsInterop.InvokeVoidAsync(JsFunctions.OpenExternalUrl, GITHUB_URL)) />
        <h4>@_manifestVersion</h4>
    </div>
</div>

@code {
    private const string WEBSITE_URL = "https://daridis.com/colorpal";
    private const string GITHUB_URL = "https://github.com/nikosdaridis/colorpal-blazor-browser-extension";

    private string? _manifestVersion;

    /// <summary>
    /// Gets manifest version and sets it to version element
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _manifestVersion = await JsInterop.InvokeAsync<string>(JsFunctions.GetManifestVersionAsync);
    }

    private void NavigateBackToHome() =>
        NavigationManager.NavigateTo("/", new NavigationOptions { HistoryEntryState = nameof(Settings) });
}
