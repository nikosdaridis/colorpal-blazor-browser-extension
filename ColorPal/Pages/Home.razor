@inherits PageBase

@page "/"

@if (!_isInitialized)
{
    return;
}

<SelectedColor NavigationManager=NavigationManager JsInterop=JsInterop LocalStorageService=LocalStorageService EventAggregator=EventAggregator StateService=StateService LocalizationService=LocalizationService />
<div class="px-3 py-2">
    <ColorCodeFormatTabs LocalStorageService=LocalStorageService EventAggregator=EventAggregator LocalizationService=LocalizationService />
    <ColorCodePanel JsInterop=JsInterop LocalStorageService=LocalStorageService EventAggregator=EventAggregator LocalizationService=LocalizationService />
</div>

<div class="grid gap-3 bg-[var(--secondary-color)] px-3 pt-1 pb-2">
    <ColorsToolBar JsInterop=JsInterop LocalStorageService=LocalStorageService EventAggregator=EventAggregator StateService=StateService LocalizationService=LocalizationService />
    <ColorsGrid JsInterop=JsInterop LocalStorageService=LocalStorageService EventAggregator=EventAggregator />
    <RatingReminder JsInterop=JsInterop EventAggregator=EventAggregator LocalizationService=LocalizationService RatingReminderService=RatingReminderService />
</div>

@code {
    private bool _isInitialized;

    /// <summary>
    /// Validates local storage and sets theme
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await LocalStorageService.ValidateAsync();
        await RatingReminderService.RecordOpenAsync();
        _isInitialized = true;

        if (await LocalStorageService.GetKeyAsync<string>(StorageKey.ShowColorNames) == "true")
        {
            _ = StateService.LoadColorNamesAsync();
        }

        _ = JsInterop.InvokeVoidAsync(JsFunctions.IsInitialized);
    }
}
