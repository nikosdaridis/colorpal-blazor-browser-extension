<div class="flex items-center justify-between">
    <h3 class="font-semibold">@Label</h3>

    @if (_theme is not null)
    {
        <button class="theme-toggle relative end-[30px] inline-flex scale-[0.2] cursor-pointer items-center justify-end"
                aria-label="Dark theme"
                aria-pressed=@(_theme == Theme.Dark.Value() ? "true" : "false")
                @onclick="ToggleThemeAsync">

            <div class="theme-toggle__track theme-toggle__track--@_theme">

                <div class="theme-toggle__sky">
                    <div class="theme-toggle__circle" />
                    <div>
                        <div class="theme-toggle__star" />
                        <div class="theme-toggle__star" />
                        <div class="theme-toggle__star" />
                    </div>
                    <div>
                        <div class="theme-toggle__cloud">
                            <div class="theme-toggle__cloud-element" />
                            <div class="theme-toggle__cloud-element" />
                        </div>
                        <div class="theme-toggle__cloud">
                            <div class="theme-toggle__cloud-element" />
                            <div class="theme-toggle__cloud-element" />
                        </div>
                        <div class="theme-toggle__cloud">
                            <div class="theme-toggle__cloud-element" />
                            <div class="theme-toggle__cloud-element" />
                            <div class="theme-toggle__cloud-element" />
                        </div>
                    </div>
                </div>
            </div>
        </button>
    }
</div>

@code {
    [Parameter]
    public LocalStorageService? LocalStorageService { get; set; }

    [Parameter]
    public string? Label { get; set; }

    private string? _theme;

    /// <summary>
    /// Initializes theme from local storage
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (LocalStorageService is null)
        {
            return;
        }

        _theme = await GetLocalStorageThemeAsync();
    }

    /// <summary>
    /// Toggles theme and saves to local storage
    /// </summary>
    private async Task ToggleThemeAsync()
    {
        if (LocalStorageService is null)
        {
            return;
        }

        _theme = await GetLocalStorageThemeAsync() == Theme.Light.Value()
            ? Theme.Dark.Value()
            : Theme.Light.Value();

        await LocalStorageService.SetThemeAsync(_theme);
    }

    /// <summary>
    /// Gets theme from local storage
    /// </summary>
    private async Task<string> GetLocalStorageThemeAsync()
    {
        if (LocalStorageService is null)
        {
            return Theme.Light.Value();
        }

        return await LocalStorageService.GetKeyAsync<string>(StorageKey.Theme) ?? Theme.Light.Value();
    }
}
