@implements IDisposable

<div id="colorToolsBar" class="flex items-center justify-between">
    @foreach (ColorToolType tool in _colorToolTypes)
    {
        <ColorTool Id=@($"colorTool-{tool.Value()}")
                   IconPath=@($"Icons/{tool.Value()}.svg")
                   IconSize=Size.Small
                   IconTextFilter=true
                   AriaLabel=@GetColorToolLabel(tool)
                   HandleClick=@(async () => await HandleColorToolClickAsync(tool))
                   IsActive=@(_activeColorTool == tool)
                   IsToggle=@IsToggleColorTool(tool) />
    }

    <select class="h-8 w-13 min-w-fit cursor-pointer items-center justify-center rounded-md bg-[var(--secondary-color)] p-2 text-sm text-[var(--text-color)] focus:ring-0"
            id="colorsPerLine"
            aria-label=@LocalizationService.GetMessage(MessageKey.ColorsPerLine)
            @bind:get=_colorsPerLine
            @bind:set=HandleColorsPerLineChangeAndPublishEventAsync>
        @for (int colorsPerLine = 5; colorsPerLine <= 10; colorsPerLine++)
        {
            <option value=@colorsPerLine>@colorsPerLine</option>
        }
    </select>
</div>

@code {
    private static readonly ColorToolType[] _colorToolTypes = [.. Enum.GetValues<ColorToolType>().Skip(1)];

    [Parameter, EditorRequired]
    public required JsInterop JsInterop { get; set; }

    [Parameter, EditorRequired]
    public required LocalStorageService LocalStorageService { get; set; }

    [Parameter, EditorRequired]
    public required EventAggregator<string> EventAggregator { get; set; }

    [Parameter, EditorRequired]
    public required StateService StateService { get; set; }

    [Parameter, EditorRequired]
    public required LocalizationService LocalizationService { get; set; }

    private ColorToolType _activeColorTool = ColorToolType.None;
    private string _colorsPerLine = "5";

    /// <summary>
    /// Subscribes to events and sets colors per line
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        EventAggregator.GetService(Event.EyedropperPick).Subscribe(ResetActiveColorToolAsync);
        EventAggregator.GetService(Event.OpenColorPicker).Subscribe(ResetActiveColorToolAsync);
        EventAggregator.GetService(Event.ColorsPerLine).Subscribe(HandleColorsPerLineChangeAsync);

        _colorsPerLine = await LocalStorageService.GetKeyAsync<string>(StorageKey.ColorsPerLine) ?? "5";
        await JsInterop.InvokeVoidAsync(JsFunctions.SetSelectValue, "colorsPerLine", _colorsPerLine);
    }

    /// <summary>
    /// Handles color tool click and publishes events
    /// </summary>
    private async Task HandleColorToolClickAsync(ColorToolType tool)
    {
        ColorToolType previousActiveColorTool = _activeColorTool;

        await RemoveMoveListenersIfActiveAsync();
        await SetActiveColorToolAsync(IsToggleColorTool(tool) && tool != _activeColorTool ? tool : ColorToolType.None);

        Task task = tool switch
        {
            ColorToolType.Move when previousActiveColorTool != ColorToolType.Move => JsInterop.InvokeVoidAsync(JsFunctions.HandleColorsMove),
            ColorToolType.Move or ColorToolType.TintsShades or ColorToolType.Delete => Task.CompletedTask,
            ColorToolType.DeleteAll => HandleDeleteAllAsync(),
            ColorToolType.DownloadPNG => HandleDownloadPNGAsync(),
            ColorToolType.DownloadCSV => HandleDownloadCSVAsync(),
            _ => throw new ArgumentOutOfRangeException(nameof(tool), $"Not expected: {tool}")
        };

        await task;

        async Task HandleDeleteAllAsync()
        {
            if ((await LocalStorageService.GetKeyAsync<string[]>(StorageKey.SavedColorsArray) ?? []).Length == 0)
            {
                return;
            }

            if (await JsInterop.InvokeAsync<bool>(JsFunctions.ConfirmAction, LocalizationService.GetMessage(MessageKey.DeleteAllConfirmation)))
            {
                await LocalStorageService.SetKeyAsync<string[]>(StorageKey.SavedColorsArray, []);
                await EventAggregator.GetService(Event.DeleteAllSavedColors).PublishAsync(ColorToolType.DeleteAll.Value());
            }
        }

        async Task HandleDownloadPNGAsync()
        {
            bool showColorNames = await LocalStorageService.GetKeyAsync<string>(StorageKey.ShowColorNames) == "true";

            if (showColorNames)
            {
                await StateService.LoadColorNamesAsync();
            }

            if (!int.TryParse(await LocalStorageService.GetKeyAsync<string>(StorageKey.ColorsPerLine), out int colorsPerLine))
            {
                colorsPerLine = 5;
            }

            await JsInterop.InvokeVoidAsync(
                JsFunctions.DownloadPng,
                await LocalStorageService.GetKeyAsync<string[]>(StorageKey.SavedColorsArray) ?? [],
                colorsPerLine,
                showColorNames,
                await LocalStorageService.GetKeyAsync<string>(StorageKey.AddHexCharacter) == "true"
            );
        }

        async Task HandleDownloadCSVAsync()
        {
            string[] savedColors = await LocalStorageService.GetKeyAsync<string[]>(StorageKey.SavedColorsArray) ?? [];

            if (savedColors.Length == 0)
            {
                return;
            }

            await StateService.LoadColorNamesAsync();

            StringBuilder csvBuilder = new();
            csvBuilder.AppendLine("Name,#HEX,HEX,RGB,HSL,HSV,Filter,Prepend Black Filter");

            foreach (string hexColor in savedColors)
            {
                ColorRGB rgbColor = await JsInterop.InvokeAsync<ColorRGB>(JsFunctions.HexToRgb, hexColor);
                string closestColorName = StateService.FindClosestRoundedColorName(rgbColor);
                CssFilter cssFilter = await JsInterop.InvokeAsync<CssFilter>(JsFunctions.HexToFilter, hexColor);
                string rgbText = await JsInterop.InvokeAsync<string>(JsFunctions.HexToRgb, hexColor, "string") ?? string.Empty;
                string hslText = await JsInterop.InvokeAsync<string>(JsFunctions.RgbToHsl, rgbColor, "string") ?? string.Empty;
                string hsvText = await JsInterop.InvokeAsync<string>(JsFunctions.RgbToHsv, rgbColor, "string") ?? string.Empty;

                CsvFormatter.AppendRow(csvBuilder,
                [
                    closestColorName,
                    hexColor,
                    hexColor.Length > 1 ? hexColor[1..] : string.Empty,
                    rgbText,
                    hslText,
                    hsvText,
                    cssFilter.Filter ?? string.Empty,
                    cssFilter.Filter?.Replace("filter:", "filter: brightness(0) saturate(100%)") ?? string.Empty
                ]);
            }

            await JsInterop.InvokeVoidAsync(JsFunctions.DownloadCsv, csvBuilder.ToString(), "ColorPal-Data");
        }
    }

    private async Task RemoveMoveListenersIfActiveAsync()
    {
        if (_activeColorTool == ColorToolType.Move)
        {
            await JsInterop.InvokeVoidAsync(JsFunctions.RemoveMoveColorsListeners);
        }
    }

    private async Task SetActiveColorToolAsync(ColorToolType activeColorTool)
    {
        _activeColorTool = activeColorTool;
        await EventAggregator.GetService(Event.SetActiveColorTool).PublishAsync(_activeColorTool.Value());
    }

    /// <summary>
    /// Resets active color tool and publishes event
    /// </summary>
    private async Task ResetActiveColorToolAsync(string hexColor)
    {
        await RemoveMoveListenersIfActiveAsync();
        await SetActiveColorToolAsync(ColorToolType.None);

        StateHasChanged();
    }

    /// <summary>
    /// Handles colors per line change and renders component
    /// </summary>
    private async Task HandleColorsPerLineChangeAsync(string colorsPerLine)
    {
        _colorsPerLine = colorsPerLine;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Handles colors per line change and publishes event
    /// </summary>
    private async Task HandleColorsPerLineChangeAndPublishEventAsync(string? colorsPerLine)
    {
        _colorsPerLine = colorsPerLine ?? "5";

        await LocalStorageService.SetKeyAsync(StorageKey.ColorsPerLine, _colorsPerLine);
        await EventAggregator.GetService(Event.ColorsPerLine).PublishAsync(_colorsPerLine);

        StateHasChanged();
    }

    private string GetColorToolLabel(ColorToolType tool) =>
        LocalizationService.GetMessage(tool switch
        {
            ColorToolType.Move => MessageKey.MoveColors,
            ColorToolType.TintsShades => MessageKey.TintsAndShades,
            ColorToolType.Delete => MessageKey.DeleteColors,
            ColorToolType.DeleteAll => MessageKey.DeleteAllColors,
            ColorToolType.DownloadPNG => MessageKey.DownloadPng,
            ColorToolType.DownloadCSV => MessageKey.DownloadCsv,
            _ => throw new ArgumentOutOfRangeException(nameof(tool), $"Not expected: {tool}")
        });

    private static bool IsToggleColorTool(ColorToolType tool) =>
        tool switch
        {
            ColorToolType.Move or ColorToolType.TintsShades or ColorToolType.Delete => true,
            ColorToolType.DeleteAll or ColorToolType.DownloadPNG or ColorToolType.DownloadCSV => false,
            _ => throw new ArgumentOutOfRangeException(nameof(tool), $"Not expected: {tool}")
        };

    /// <summary>
    /// Unsubscribes from events
    /// </summary>
    public void Dispose()
    {
        EventAggregator.GetService(Event.EyedropperPick).Unsubscribe(ResetActiveColorToolAsync);
        EventAggregator.GetService(Event.OpenColorPicker).Unsubscribe(ResetActiveColorToolAsync);
        EventAggregator.GetService(Event.ColorsPerLine).Unsubscribe(HandleColorsPerLineChangeAsync);
    }
}
